# Copy to .env. Leave a key blank to skip that provider.
# GLASS_BOX_MODE=offline runs every demo and bin/learn on recorded or stubbed
# replies, with no network. Unset, the tools call a provider when its key is
# present and use a fixture when it is not.

GLASS_BOX_MODE=

# Chat, embeddings, moderation, speech, transcription, and images.
OPENAI_API_KEY=

# Chat. Optional fallback provider.
ANTHROPIC_API_KEY=

# Chat. With no TypeSafe or OpenAI key, judgments use gemini-decision-1.
GEMINI_API_KEY=
# Used only when GEMINI_API_KEY is blank.
GOOGLE_API_KEY=

# Chat. With only this key set, the course uses model openai/gpt-4o-mini on OpenRouter.
# Set RUBYLLM_MODEL to choose a different OpenRouter id.
OPENROUTER_API_KEY=

# Chat on xAI. Video also needs this key and GLASS_BOX_PAID_MEDIA=1.
XAI_API_KEY=

# Optional. Rerank uses Cohere when this is set.
COHERE_API_KEY=

# Optional. OCR uses Mistral when this is set. The default OCR model is mistral-ocr-latest.
MISTRAL_API_KEY=

# Optional. Judgments default to TypeSafe jev-latest. An OpenAI key can judge with gpt-6-luna instead.
TYPESAFE_API_KEY=

# Optional speech provider. Speak uses OpenAI when OPENAI_API_KEY is set.
ELEVENLABS_API_KEY=

# Optional rerank route when Cohere is not configured. Example model: voyageai/rerank-2.5-lite
RUBYLLM_RERANK_MODEL=
RUBYLLM_RERANK_PROVIDER=

# Optional image route when paint should not use the OpenAI default.
RUBYLLM_IMAGE_MODEL=
RUBYLLM_IMAGE_PROVIDER=

# Optional override for RubyLLM.chat. Example: RUBYLLM_MODEL=claude-sonnet-5 and RUBYLLM_PROVIDER=anthropic.
RUBYLLM_MODEL=
RUBYLLM_PROVIDER=

# paint and animate bill immediately and animate waits for a render.
# They stay on the fixture unless this is 1, even when a key is present.
GLASS_BOX_PAID_MEDIA=

# RubyLLM.batch submits a provider batch. It stays staged locally unless this is 1.
GLASS_BOX_BATCH=

# Approval demos read this when stdin is not a terminal. yes approves, anything else declines.
GLASS_BOX_APPROVE=
