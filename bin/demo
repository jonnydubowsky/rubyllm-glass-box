#!/usr/bin/env bash
# Run one tour demo, or every demo.
#   bin/demo 8                     by number
#   bin/demo 08                    a leading zero is fine
#   bin/demo 08-mcp-linear         by folder name
#   bin/demo demos/08-mcp-linear   by path
#   bin/demo all                   every demo, in order
#   bin/demo list                  print the folder names
set -euo pipefail
cd "$(dirname "$0")/.."
shopt -s nullglob

usage() {
  echo "Usage: bin/demo <number|folder|all|list>" >&2
  echo "Example: GLASS_BOX_MODE=offline bin/demo 02" >&2
}

run_dir() {
  echo "---- $1 ----"
  bundle exec ruby "$1/run.rb"
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

# Numbered folders only, so demos/fixtures is never treated as a demo.
demos=(demos/[0-9][0-9]-*/run.rb)

target="${1#demos/}"
target="${target%/}"

case "$target" in
  all)
    for script in "${demos[@]}"; do
      run_dir "$(dirname "$script")"
    done
    exit 0
    ;;
  list)
    for script in "${demos[@]}"; do
      basename "$(dirname "$script")"
    done
    exit 0
    ;;
esac

if [[ "$target" =~ ^[0-9]+$ ]]; then
  # 10# reads the digits as base 10. Without it, bash reads 08 as bad octal.
  number="$(printf '%02d' "$((10#$target))")"
  matches=(demos/"$number"-*/run.rb)
  if [[ ${#matches[@]} -eq 1 ]]; then
    run_dir "$(dirname "${matches[0]}")"
    exit 0
  fi
  echo "No demo has the number $target. The demos run from 01 to $(printf '%02d' "${#demos[@]}")." >&2
  exit 1
fi

if [[ "$target" =~ ^[0-9][0-9]- && -f "demos/$target/run.rb" ]]; then
  run_dir "demos/$target"
  exit 0
fi

echo "No demo matches '$1'. Run bin/demo list to see the folder names." >&2
exit 1
