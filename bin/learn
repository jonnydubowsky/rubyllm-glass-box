#!/usr/bin/env ruby
# frozen_string_literal: true

# Take the guided course.
#   bin/learn           print the next lesson, then run its step
#   bin/learn 4         print lesson 4, then run step 4
#   bin/learn run 4     the same as bin/learn 4
#   bin/learn status    list the steps and the saved checkpoints
#   bin/learn auto      run every step with no lesson text, approving tool calls
#   bin/learn reset     clear the saved checkpoints

if ARGV.include?("auto")
  ENV["GLASS_BOX_APPROVE"] = "yes" if ENV["GLASS_BOX_APPROVE"].to_s.strip.empty?
end

require_relative "../lib/glass_box/learn"

command = ARGV[0]
ok = case command
     when nil, "next"
       GlassBox::Learn.next!
     when "status"
       GlassBox::Learn.status
       true
     when "reset"
       GlassBox::Learn.reset!
       true
     when "auto"
       GlassBox::Learn.auto!
     when "run"
       GlassBox::Learn.run!(ARGV[1])
     else
       GlassBox::Learn.run!(command)
     end

exit(ok ? 0 : 1)
